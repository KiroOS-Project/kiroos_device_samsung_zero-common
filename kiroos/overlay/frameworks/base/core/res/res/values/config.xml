<?xml version="1.0" encoding="utf-8"?>
<!-- KiroOS framework defaults shared by the Galaxy S6 family. Memory killer thresholds are
     per device (RAM and zram size differ), see each device's overlay. -->
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">

    <!-- Wi-Fi scan interval while disconnected (180 s) to prevent battery drain -->
    <integer translatable="false" name="config_wifi_framework_scan_interval">180000</integer>

    <!-- Compact power menu: power off and restart only -->
    <string-array translatable="false" name="config_globalActionsList">
        <item>power</item>
        <item>restart</item>
    </string-array>

    <!-- Calibrated 12 ms haptic tap -->
    <integer-array name="config_keyboardTapVibePattern">
        <item>12</item>
    </integer-array>

    <!-- KiroOS Beta 4.1 haptics: one clean pulse per action, never a buzz. The S6's motor needs
         about 10 ms to spin up, so taps are 10-14 ms (crisp, felt, not heard) and the long press
         is one firmer 24 ms pulse. The stock patterns were double pulses (10 + 30 ms with a pause)
         that felt soft and late. Patterns: {delay, on} in ms. -->
    <integer-array name="config_virtualKeyVibePattern">
        <item>0</item>
        <item>14</item>
    </integer-array>
    <integer-array name="config_longPressVibePattern">
        <item>0</item>
        <item>24</item>
    </integer-array>
    <integer-array name="config_contextClickVibePattern">
        <item>0</item>
        <item>10</item>
    </integer-array>
    <integer-array name="config_clockTickVibePattern">
        <item>0</item>
        <item>10</item>
    </integer-array>
    <integer-array name="config_calendarDateVibePattern">
        <item>0</item>
        <item>10</item>
    </integer-array>

    <!-- Always-on display: shift the ambient content around (anti burn-in) -->
    <bool name="config_enableBurnInProtection">true</bool>

    <!-- Kiro Messages is the default SMS / MMS app -->
    <string name="default_sms_application" translatable="false">com.kiroos.messages</string>

</resources>
