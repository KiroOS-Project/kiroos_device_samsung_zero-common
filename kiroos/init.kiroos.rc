# KiroOS init, shared by the Galaxy S6 family (S6, S6 edge, S6 edge+).
# Imported by init.samsungexynos7420.rc of both hardware common trees, after their own
# "on fs" mount_all, so swapon_all below runs with /system mounted.

on post-fs
    # cfq idles waiting for more I/O, which only suits spinning disks; deadline gives UFS
    # lower latency for less CPU. Per request I/O statistics are debug only.
    write /sys/block/sda/queue/scheduler deadline
    write /sys/block/sda/queue/iostats 0

on fs
    # zram swap (LZO); the size comes from the zramsize of each device's fstab
    swapon_all /fstab.samsungexynos7420

on boot
    # Compressing idle apps into zram is cheaper than killing them (100 is this kernel's max)
    write /proc/sys/vm/swappiness 100

    # Touchkeys (S6 family capacitive keys)
    chown system system /sys/class/sec/sec_touchkey/brightness
    chmod 0660 /sys/class/sec/sec_touchkey/brightness
    chown system system /sys/class/sec/sec_touchkey/touchkey_brightness
    chmod 0660 /sys/class/sec/sec_touchkey/touchkey_brightness
    chown system system /sys/class/sec/sec_touchkey/input/enabled
    chmod 0660 /sys/class/sec/sec_touchkey/input/enabled

    # Edge screen: touch IC edge handler (palm rejection on the curved sides)
    chown system system /sys/class/sec/tsp/cmd
    chmod 0660 /sys/class/sec/tsp/cmd

# kAI models: /data/kiroos/models holds links to the ones in the ROM (a model copied there with
# the same name is used instead)
on post-fs-data
    mkdir /data/kiroos 0775 system system
    mkdir /data/kiroos/models 0775 system system
    # Beta 5: the chat models left the ROM; the old links of an updated phone go
    rm /data/kiroos/models/qwen3-0.6b-q4_k_m.gguf
    rm /data/kiroos/models/smollm2-135m-instruct-q4_k_m.gguf
    rm /data/kiroos/models/llama-3.2-1b-instruct-q4_k_m.gguf
    symlink /system/usr/share/kai/whisper-base-q5_1.bin /data/kiroos/models/whisper-base-q5_1.bin

# Kiro Thermal Guardian / Battery Guardian (decided in SystemUI, KiroGuardian)
on property:sys.kiroos.guard.thermal=*
    start kiroos_perf

# screen off: no clock floors (every profile), see kiroos_perf.sh
on property:sys.kiroos.guard.screen=*
    start kiroos_perf

# Battery Guardian (kernel batt_kiro_charge): 0 normal, 1 charging stops at 80% and restarts at
# 77%, 2 bypass (the charger powers the phone, the battery is not charged). The charger and USB
# stay connected in every mode.
on property:sys.kiroos.guard.charge=*
    write /sys/class/power_supply/battery/batt_kiro_charge ${sys.kiroos.guard.charge}

# The battery's real capacity (kernel batt_kiro_cap, learned when the battery runs empty after a
# full charge): saved by kiroos_perf.sh when KiroGuardian sees the charge drop, given back to the
# kernel at every boot.
on property:persist.sys.kiroos.batt_cap=*
    write /sys/class/power_supply/battery/batt_kiro_cap ${persist.sys.kiroos.batt_cap}

# Beta 4: the battery's cycles (kernel batt_kiro_cycle, % used), saved by kiroos_perf.sh, given
# back at boot. The battery's past comes from Samsung's own count, kept in /efs from the stock
# firmware (% discharged over the battery's life, cycles = /100): only read, never written. The
# kernel keeps the highest value written, so the order of the two does not matter.
on post-fs-data
    copy /efs/FactoryApp/batt_discharge_level /sys/class/power_supply/battery/batt_kiro_cycle
    # Beta 4.1: the Natural colour mode by default, once (before system_server reads it)
    exec - root system -- /system/bin/kiroos_perf.sh naturalcolors

on property:persist.sys.kiroos.batt_cycle=*
    write /sys/class/power_supply/battery/batt_kiro_cycle ${persist.sys.kiroos.batt_cycle}

on property:sys.kiroos.guard.battcap=*
    start kiroos_battcap

# Beta 3: the KiroOS recovery comes back by itself. install-recovery.sh checks the RECOVERY
# partition at every boot and rebuilds it from boot + recovery-from-boot.p when it differs (TWRP
# flashed over it, or an update that changed it), so KiroOS Update's installs always find it.
# A developer who wants to keep another recovery: setprop persist.sys.kiroos.keeprecovery 1
on property:sys.boot_completed=1 && property:persist.sys.kiroos.keeprecovery=0
    start flash_recovery

# Beta 4: app caches cleared at every boot, a minute after it completed (kiroos_perf.sh)
on property:sys.boot_completed=1
    start kiroos_trimcache
    start kiroos_battlog

# Beta 4.1: battery log, one line a minute (kiroos_diag.sh battlog, /data/kiroos/battlog.txt)
service kiroos_battlog /system/bin/kiroos_diag.sh battlog
    class main
    user root
    group root system
    disabled

service kiroos_trimcache /system/bin/kiroos_perf.sh trimcache
    class main
    user root
    group root system
    disabled
    oneshot

service kiroos_battcap /system/bin/kiroos_perf.sh battcap
    class main
    user root
    group root system
    disabled
    oneshot

# Battery profiles (Settings > Battery > Profiles), see /system/bin/kiroos_perf.sh
service kiroos_perf /system/bin/kiroos_perf.sh
    class main
    user root
    group root system
    disabled
    oneshot

# Compile the apps once after a system update (see /system/bin/kiroos_dexopt.sh)
service kiroos_dexopt /system/bin/kiroos_dexopt.sh
    class main
    user root
    group root system
    disabled
    oneshot

# KeurStore: an app it installed is compiled ahead of time
service kiroos_optimize /system/bin/kiroos_dexopt.sh optimize
    class main
    user root
    group root system
    disabled
    oneshot
    seclabel u:r:kiroos_dexopt:s0

on property:sys.kiroos.guard.optimize=*
    start kiroos_optimize

on property:sys.boot_completed=1
    start kiroos_perf
    start kiroos_diag_boot
    start kiroos_dexopt

on property:persist.sys.kiroos.perf=*
    start kiroos_perf

# Restore the Bluetooth MAC address from the EFS partition
service btfirmware /system/bin/sh /system/bin/init.btmac.sh
    class core
    user root
    group root bluetooth system
    oneshot

# Touchkey LED. "brightness" is the LED on/off command of the touchkey IC; PowerManager turns
# it on with use and off after the button timeout (lights HAL). "touchkey_brightness" is the
# LED LDO voltage in mV (fixed 3.3 V), never written as an on/off value.
on property:persist.sys.touchkey_led=0
    write /sys/class/sec/sec_touchkey/brightness 0
    write /sys/class/sec/sec_touchkey/input/enabled 0

on property:persist.sys.touchkey_led=1
    write /sys/class/sec/sec_touchkey/input/enabled 1

# On-screen navigation bar
on property:persist.sys.qemu.mainkeys=0
    setprop qemu.hw.mainkeys 0
    write /sys/class/sec/sec_touchkey/input/enabled 0
    write /sys/class/sec/sec_touchkey/brightness 0

on property:persist.sys.qemu.mainkeys=1
    setprop qemu.hw.mainkeys 1
    write /sys/class/sec/sec_touchkey/input/enabled 1

# Swipe up from the bottom wakes the screen (touch IC low power gesture), Settings > Display
on property:persist.sys.kiroos.swipe_wake=1
    write /sys/class/sec/tsp/cmd spay_enable,1

on property:persist.sys.kiroos.swipe_wake=0
    write /sys/class/sec/tsp/cmd spay_enable,0

# Edge screen palm rejection (S6 edge / edge+): set_dead_zone of the STM touch IC
# (fts and fts5ad56 drivers) makes it ignore touches that start on the curved sides.
#   3 = both edges, 4 = right edge only (left off), 5 = left edge only (right off), 6 = off
# Settings > Display > Edge screen sets persist.sys.kiroos.edge_zone; ro.kiroos.edge marks
# the edge models. The touch IC forgets it on reset, so it is applied again after boot.
on property:persist.sys.kiroos.edge_zone=* && property:ro.kiroos.edge=1
    write /sys/class/sec/tsp/cmd set_dead_zone,${persist.sys.kiroos.edge_zone}

on property:sys.boot_completed=1 && property:ro.kiroos.edge=1
    write /sys/class/sec/tsp/cmd set_dead_zone,${persist.sys.kiroos.edge_zone}

# KiroOS local diagnostics, saved in internal storage (KiroOS/diagnostics)
#   setprop debug.kiroos.diag snapshot   (logs, kernel, battery, memory, thermal)
#   setprop debug.kiroos.diag monitor    (thermal/CPU/battery every 10 s for 10 minutes)
service kiroos_diag /system/bin/kiroos_diag.sh snapshot
    class late_start
    user root
    group root
    disabled
    oneshot

service kiroos_diag_mon /system/bin/kiroos_diag.sh monitor
    class late_start
    user root
    group root
    disabled
    oneshot

service kiroos_diag_boot /system/bin/kiroos_diag.sh boot
    class late_start
    user root
    group root
    disabled
    oneshot

on property:debug.kiroos.diag=snapshot
    start kiroos_diag

on property:debug.kiroos.diag=monitor
    start kiroos_diag_mon

# Doze reaches deep idle sooner (standby battery), see kiroos_doze.sh
service kiroos_doze /system/bin/kiroos_doze.sh
    class late_start
    user root
    seclabel u:r:kiroos_dexopt:s0
    disabled
    oneshot

on property:sys.boot_completed=1
    start kiroos_doze
